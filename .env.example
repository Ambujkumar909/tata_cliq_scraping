# ─────────────────────────────────────────────────────────────
# PriceLens — environment configuration
# Copy to .env and adjust as needed. docker-compose reads these too.
# ─────────────────────────────────────────────────────────────

# API
PORT=4010
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Redis (cache + ingestion store)
REDIS_URL=redis://localhost:6379

# Fetching
# Everything is pure HTTP — there is no headless browser in this stack.
HTTP_TIMEOUT_MS=20000
# Residential/mobile proxy for Akamai-walled hosts (http://user:pass@host:port).
# Ajio's PDP rejects datacenter IPs outright; an Indian residential egress
# unlocks its detail tier (specs, descriptions, style codes → better matching).
# Verify with:  node scripts/test-proxy.mjs
SCRAPE_PROXY=
# Hosts routed through the proxy (suffix match). Everything else stays direct,
# so residential bandwidth is spent only where it is needed.
PROXY_HOSTS=ajio.com

# Matching
# Minimum evidence score [0..1] for a competitor match to be surfaced.
# Aligns with the PARTIAL MATCH tier (see apps/api/src/matching/evidence.mjs).
MATCH_MIN_SCORE=0.58

# Exact-SKU mode (default true). Rejects any colour-FAMILY disagreement
# (grey vs black, navy vs brown) outright rather than accepting it on image
# proof. Set to false to trade precision for coverage.
STRICT_SKU=true

# Ingestion
INGEST_TARGET_COUNT=2000
# Comma-separated Tata CLIQ seed search terms used to build the anchor catalog.
INGEST_TERMS=tshirt,shirt,jeans,kurta,dress,shoes,watch,handbag,jacket,saree
