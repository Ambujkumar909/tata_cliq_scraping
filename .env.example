# ─────────────────────────────────────────────────────────────
# PriceLens — environment configuration
# Copy to .env and adjust as needed. docker-compose reads these too.
# ─────────────────────────────────────────────────────────────

# API
PORT=4010
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Redis (cache + ingestion store)
REDIS_URL=redis://localhost:6379

# Fetching
# Everything is pure HTTP — there is no headless browser in this stack.
HTTP_TIMEOUT_MS=20000
# Residential/mobile proxy for Akamai-walled hosts (http://user:pass@host:port).
# Ajio's PDP rejects datacenter IPs outright; an Indian residential egress
# unlocks its detail tier (specs, descriptions, style codes → better matching).
# Verify with:  node scripts/test-proxy.mjs
SCRAPE_PROXY=
# Hosts routed through the proxy (suffix match). Everything else stays direct,
# so residential bandwidth is spent only where it is needed.
PROXY_HOSTS=ajio.com

# Matching
# Minimum evidence score [0..1] for a competitor match to be surfaced.
# Aligns with the PARTIAL MATCH tier (see apps/api/src/matching/evidence.mjs).
MATCH_MIN_SCORE=0.58

# Saved comparisons: how long a generated report is replayed before the next
# view re-scrapes it. Every match is persisted (Redis, or a JSON snapshot in
# CACHE_DIR when Redis is unreachable) and survives restarts, so the same
# product is never compared twice inside this window. "Refresh live" always
# bypasses it. Set higher to scrape less, lower to track price moves closer.
REPORT_TTL_HOURS=168
# Where the fallback snapshot is written. Defaults to apps/api/data.
CACHE_DIR=

# Recent searches: how long a product compared from a pasted link stays pinned
# to the top of the catalog ("Recent searches"). Shorter than the report TTL on
# purpose — the saved report is still worth replaying for a week, but a strip
# that never clears stops being a shortcut. Set 0 to disable the strip.
RECENT_TTL_HOURS=48
# How many cards the strip shows.
RECENT_LIMIT=12

# Bulk import: upload a sheet of CLIQ links and compare every one.
# Concurrency is capped by Myntra's and Ajio's tolerance, not by CPU — each row
# is three storefronts plus image hashing, and a burst is what trips Akamai.
# 4 measured ~1.6s/product while staying unblocked; raise only behind a proxy.
IMPORT_CONCURRENCY=4
# Guards against an accidental 500k-row upload.
IMPORT_MAX_ROWS=20000
IMPORT_MAX_UPLOAD_MB=25
# How long finished jobs and their row-level results are kept (default 30 days).
IMPORT_JOB_TTL_HOURS=720

# Exact-SKU mode (default true). Rejects any colour-FAMILY disagreement
# (grey vs black, navy vs brown) outright rather than accepting it on image
# proof. Set to false to trade precision for coverage.
STRICT_SKU=true

# ── Ajio product-detail tier (specs, fabric, wash, description) ──────────
# Ajio's PDP API only answers requests made from inside a real browser page —
# not a proxy problem, and headless Chrome is refused outright. Turning this on
# runs ONE headed Chromium page (on a virtual display in Docker) and routes PDP
# reads through it: ~3s for the first product, ~0.7s each thereafter.
#
#   1. Build the image with the browser baked in:
#        WITH_BROWSER=true docker compose build api
#   2. Set this to true and restart.
#
# Leave false to stay pure-HTTP: Ajio prices and matching work exactly as
# before, only its Specifications cells read "not available".
AJIO_BROWSER_COOKIES=false
# Browser binary (Docker default shown; on Windows/macOS leave blank to use the
# installed Chrome/Edge automatically).
CHROME_PATH=/usr/bin/chromium-browser

# Ingestion
INGEST_TARGET_COUNT=2000
# Comma-separated Tata CLIQ seed search terms used to build the anchor catalog.
INGEST_TERMS=tshirt,shirt,jeans,kurta,dress,shoes,watch,handbag,jacket,saree
